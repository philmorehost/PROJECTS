# Block direct HTTP access to logs, SQL migrations, CLI tools, tests, and dependency manifests
<FilesMatch "\.(log|sql|md|lock|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(logs|bin|install|tests|includes)/ - [F,L]
</IfModule>
