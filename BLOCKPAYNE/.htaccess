Options -Indexes -MultiViews
ServerSignature Off

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve Authorization header on cPanel CGI/FastCGI PHP-FPM setups for REST API v1
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Block direct HTTP access to private directories and sensitive files
    RewriteRule ^(app|bin|database|resources|storage|tests|node_modules)(/|$) - [F,L]
    RewriteRule ^(\.env|\.git|artisan|composer\.json|package\.json|version\.json) - [F,L]

    # Route dynamic favicon request
    RewriteRule ^favicon\.svg$ index.php?route=favicon [QSA,L]

    # Serve existing public static files directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(public|manifest\.webmanifest|sw\.js) - [L]

    # Clean routes: /pay/{invoice_id}, /link/{slug}, /api/v1/*, /install, /dashboard, /login, /register
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
