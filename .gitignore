
# Upload bundles built for the host
/KINGDOMBUILDERS-*-upload.zip
# Release signing material and build artifacts (never commit)
# A committed .jks permanently leaks the upload key for every clone, fork and backup.
VTU/play-signing-keys/
*.jks
*.keystore
*.p12
*.pfx
*-cert.pem
*-cert.der
key.properties
keystore.properties

# Signed bundles/APKs produced for upload, and their hand-off notes
**/release-output/
*.aab

# Node tooling for the repo's own checks (installed, never committed)
tools/**/node_modules/

# Runtime OTA backups, temporary update staging and logs (SMSP + LM)
SMSP/backups/
SMSP/tmp_update/
SMSP/logs/
SMSP/config/.sys_cache
secure_updates/
LM/*.log
LM/storage/logs/*.log
PAYHUB/logs/*.log

# Local PHP-wasm test harness (installed, never committed)
VTU/tests/harness/node_modules/

# Per-installation database credentials and license tokens (written by the install
# wizards on the live server; a committed copy broke every NON-SAAS page and leaks
# credentials). Never commit these again.
VTU/DGV7.0-SAAS/func/db-json.php
VTU/DGV7.0-NON-SAAS/func/db-json.php
VTU/DGV7.0-NON-SAAS/func/levelup.php
VTU/DGV7.0-NON-SAAS/installed.lock
VTU/DGV7.0-NON-SAAS/func/cache/
