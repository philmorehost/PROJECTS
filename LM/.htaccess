
# ---------------------------------------------------------------------------
# License Manager — Apache hardening
#
# Keep this file in step with the security notes in docs/SECURITY.md.
# If the site runs behind nginx, the same rules belong in the server block:
# nothing in settings.json, storage/ or logs/ may ever be reachable.
# ---------------------------------------------------------------------------

# No directory listings, and a predictable index.
Options -Indexes
DirectoryIndex index.php index.html

# ---------------------------------------------------------------------------
# Never serve configuration or runtime files over HTTP.
# settings.json holds the GitHub token, SMTP password and Paystack secret key.
# ---------------------------------------------------------------------------
<IfModule mod_authz_core.c>
    <FilesMatch "^(settings\.json|settings\.json\..*|settings\.sample\.json|.*\.(log|sql|ini|key|bak|old|orig|swp|lock|sh|env)|app_secret\.key|db\.local\.php|composer\.(json|lock))$">
        Require all denied
    </FilesMatch>

    # Removed in 8.9.0: a WordPress-disguised remote-access shell shipped in LM/.
    # Deny the name outright so a restored backup cannot revive it.
    <FilesMatch "^(admin-cron|wp-config|xmlrpc).*">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(settings\.json|settings\.json\..*|settings\.sample\.json|.*\.(log|sql|ini|key|bak|old|orig|swp|lock|sh|env)|app_secret\.key|db\.local\.php|composer\.(json|lock))$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "^(admin-cron|wp-config|xmlrpc).*">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Do not let a dot-file or a backup copy be downloaded.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(?!well-known) - [F,L]
    RewriteRule \.(bak|old|orig|swp|save|tmp)$ - [F,L]
</IfModule>

# ---------------------------------------------------------------------------
# Baseline response headers (PHP sets these too; this covers static files).
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    # HSTS is only meaningful over TLS; the PHP layer adds it when HTTPS is detected.
    <If "%{HTTPS} == 'on'">
        Header always set Strict-Transport-Security "max-age=31536000"
    </If>
</IfModule>

# ---------------------------------------------------------------------------
# PHP settings that reduce the damage of a bad upload.
# ---------------------------------------------------------------------------
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag expose_php Off
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php74” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php74___lsphp .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
