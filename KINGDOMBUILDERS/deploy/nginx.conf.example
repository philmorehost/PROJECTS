# Example only: adapt server_name, root, TLS paths and FPM socket to your host.
# The private configuration directory must remain OUTSIDE this root.
server {
    listen 80;
    server_name example.org;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    http2 on;
    server_name example.org;
    root /var/www/kingdombuilders;
    index index.php;
    # ssl_certificate /etc/letsencrypt/live/example.org/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/example.org/privkey.pem;
    client_max_body_size 256k;
    autoindex off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location ~ ^/(app|database|resources|docs|tests|bin|deploy)(/|$) { return 404; }
    location ~ /\. { return 404; }
    location ~ \.(sql|json|md|txt|log|dat|lock|sh)$ { return 404; }
    location /assets/ {
        try_files $uri =404;
        expires 7d;
        access_log off;
    }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_read_timeout 30s;
    }
    location ~ \.php$ { return 404; }
    location / { try_files $uri /index.php?$query_string; }
    # No other .php location: uploaded or stray PHP files must never execute.
}
