# ─── Server ─────────────────────────────────────────────────────────────
# Keep this on 127.0.0.1 (or a private network). Only your PHP site should reach it.
HOST=127.0.0.1
PORT=8787
DB_PATH=./data/mzeevtu-crypto.db

# ─── Wallet ─────────────────────────────────────────────────────────────
# 12/24-word seed phrase. Index 0 = your HOT WALLET (fund it with the crypto you sell).
# Index 1,2,3... = one-time deposit addresses for users who sell to you.
# Generate one with:  npm run new-wallet
# NEVER commit this, never put it in PHP or JavaScript that runs in the browser.
MNEMONIC="replace with your twelve or twenty four word seed phrase"

# ─── Secrets shared with the PHP bridge (min 32 chars each, all different) ──
API_SECRET=change-me-to-a-long-random-string-1
ADMIN_SECRET=change-me-to-a-long-random-string-2
CALLBACK_SECRET=change-me-to-a-long-random-string-3
# Optional dedicated secrets for /v1/cbs/signer and /v1/cbs/watcher (match CRYPTO_SIGNER_HMAC_SECRET & CRYPTO_WATCHER_HMAC_SECRET)
# CBS_SIGNER_SECRET=change-me-to-a-long-random-string-4
# CBS_WATCHER_SECRET=change-me-to-a-long-random-string-5
# Where this service tells your site to credit / refund user wallets
CALLBACK_URL=https://mzeevtu.com/crypto/callback.php

# ─── Assets & networks ───────────────────────────────────────────────────
# Available: USDT_BSC, USDC_BSC, BNB, ETH, USDT_ETH, USDC_ETH, USDT_POLYGON, POL, USDT_TRON, TRX, BTC
ENABLED_ASSETS=USDT_TRON,USDT_BSC,BTC
RPC_BSC=https://bsc-dataseed.bnbchain.org
# RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_POLYGON=https://polygon-rpc.com
# Optional confirmation overrides:  CONFIRMATIONS_BSC=15   CONFIRMATIONS_BITCOIN=2

# ─── TRON (USDT-TRC20, TRX) ──────────────────────────────────────────────
# Defaults to TronGrid. Get a free API key at trongrid.io (without one you'll hit rate limits).
# RPC_TRON=https://api.trongrid.io
TRON_API_KEY=
# Max TRX a single TRC20 transfer may burn for energy (safety cap)
TRON_FEE_LIMIT_TRX=100
# Refuse USDT payouts if the hot wallet has less TRX than this (refund instead)
TRON_MIN_HOT_TRX=30
# TRX sent to a deposit address so it can forward USDT to the hot wallet (leftover is returned)
TRON_SWEEP_TRX=35

# ─── Bitcoin ─────────────────────────────────────────────────────────────
# Any Esplora-compatible API. Defaults to mempool.space.
# RPC_BITCOIN=https://mempool.space/api
# Fee speed: fastestFee | halfHourFee | hourFee | economyFee
BTC_FEE_LEVEL=halfHourFee

# ─── Pricing ─────────────────────────────────────────────────────────────
FIAT_CURRENCY=NGN
# Your margin in basis points (150 = 1.5%). Buy price = market + spread, sell price = market - spread.
BUY_SPREAD_BPS=150
SELL_SPREAD_BPS=150
# Optional CoinGecko demo/pro key (higher rate limits)
COINGECKO_API_KEY=
# Tip: you can also set your own fixed rates via POST /v1/admin/rates (overrides market price)

# ─── Limits & timing ─────────────────────────────────────────────────────
MIN_FIAT=1000
MAX_FIAT=2000000
QUOTE_TTL_SEC=120
SELL_WINDOW_MIN=60
# Accept overpayment on sells up to this (bps) before sending to manual review
SELL_OVERPAY_BPS=200
BUY_STUCK_MINUTES=30
