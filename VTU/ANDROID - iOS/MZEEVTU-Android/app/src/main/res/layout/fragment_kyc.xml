<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:tag="brand:bg=background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Toolbar -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:background="@color/primary" android:gravity="center_vertical"
            android:paddingStart="8dp" android:paddingEnd="12dp" android:tag="brand:bg=primary">
            <ImageButton android:id="@+id/btn_back"
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@drawable/ic_home"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF" android:contentDescription="Back" android:tag="brand:icon=primary_text" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Identity Verification (KYC)"
                android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"
                android:layout_marginStart="4dp" />
            <Button android:id="@+id/btn_kyc_notifications"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="Alerts"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                style="@style/Widget.Material3.Button.TextButton" />
        </LinearLayout>

        <!-- Mandatory Compliance Gate Lock Banner -->
        <LinearLayout android:id="@+id/ll_compliance_banner"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp"
            android:background="#0F172A" android:visibility="gone">
            <TextView android:id="@+id/tv_compliance_banner_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Verification Required to Unlock App"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_compliance_banner_msg"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Wallet, transfers, and service purchases remain locked until your identity is verified and approved."
                android:textColor="#CBD5E1" android:textSize="12sp" android:layout_marginTop="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="10dp">
                <Button android:id="@+id/btn_refresh_kyc_status"
                    android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
                    android:text="Refresh Status" android:textSize="12sp"
                    android:layout_marginEnd="8dp"
                    style="@style/Widget.Material3.Button.TonalButton" />
                <Button android:id="@+id/btn_kyc_sign_out"
                    android:layout_width="wrap_content" android:layout_height="38dp"
                    android:text="Sign Out" android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    style="@style/Widget.Material3.Button.OutlinedButton" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <ProgressBar android:id="@+id/progress_bar"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <!-- Status card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="VERIFICATION STATUS" android:textSize="11sp" android:textStyle="bold"
                        android:textColor="@color/text_secondary" android:layout_marginBottom="8dp" android:tag="brand:text=on_surface" />
                    <TextView android:id="@+id/tv_kyc_status"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="KYC Status: Loading..."
                        android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tv_bvn_status"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="BVN Saved: —"
                        android:textSize="13sp" android:layout_marginBottom="2dp"/>
                    <TextView android:id="@+id/tv_nin_status"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="NIN Saved: —"
                        android:textSize="13sp"/>
                    <TextView android:id="@+id/tv_ai_screening_badge"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="" android:textSize="12sp" android:textColor="#1D4ED8"
                        android:layout_marginTop="6dp" android:visibility="gone" />
                    <TextView android:id="@+id/tv_still_needed"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="" android:textSize="12sp" android:textColor="#B45309"
                        android:layout_marginTop="6dp" android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Rejection Reason Banner -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_reject_reason"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp" android:visibility="gone"
                app:cardBackgroundColor="#FEF2F2" app:cardCornerRadius="12dp" app:cardElevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Action Required — Submission Rejected"
                        android:textColor="#B91C1C" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_reject_reason_text"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="" android:textColor="#7F1D1D" android:textSize="13sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Pending Human Review Lock Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_pending_lock"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="16dp" android:visibility="gone"
                app:cardBackgroundColor="#FFFBEB" app:cardCornerRadius="14dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="⏳ Verification Under Compliance Review"
                        android:textColor="#92400E" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_pending_summary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Your required documents passed automated security &amp; AI checks and are awaiting compliance approval. You will receive a push &amp; email alert as soon as your account unlocks."
                        android:textColor="#78350F" android:textSize="13sp" android:layout_marginTop="6dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="12dp">
                        <Button android:id="@+id/btn_pending_refresh"
                            android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                            android:text="Check Approval Status" android:textSize="12sp"
                            android:layout_marginEnd="8dp"
                            style="@style/Widget.Material3.Button" />
                        <Button android:id="@+id/btn_pending_toggle_edit"
                            android:layout_width="wrap_content" android:layout_height="40dp"
                            android:text="Update Files" android:textSize="12sp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout android:id="@+id/ll_kyc_forms_container"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button android:id="@+id/btn_start_vove_i_d"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:text="Start VoveID Verification"
                    android:textSize="15sp" android:textStyle="bold"
                    android:backgroundTint="@color/primary"
                    style="@style/Widget.Material3.Button"
                    android:layout_marginBottom="20dp" android:visibility="gone" android:tag="brand:bg=primary;button=fill" />

                <!-- BVN / NIN Section -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="STEP 1 — IDENTITY NUMBER (BVN / NIN)" android:textSize="11sp" android:textStyle="bold"
                    android:textColor="@color/text_secondary" android:layout_marginBottom="10dp" android:tag="brand:text=on_surface" />

                <RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <RadioButton android:id="@+id/rb_bvn"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="BVN" android:checked="true" android:layout_marginEnd="20dp" android:tag="brand:button=fill" />
                    <RadioButton android:id="@+id/rb_nin"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="NIN" android:tag="brand:button=fill" />
                </RadioGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="BVN or NIN Number"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="12dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_bvn_nin_value"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="number" android:maxLength="12"/>
                </com.google.android.material.textfield.TextInputLayout>

                <Button android:id="@+id/btn_save_bvn_nin"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="Verify &amp; Save BVN / NIN"
                    android:textSize="14sp"
                    android:backgroundTint="@color/primary"
                    style="@style/Widget.Material3.Button"
                    android:layout_marginBottom="24dp" android:tag="brand:bg=primary;button=fill" />

                <!-- Document Upload Section -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="STEP 2 — GUIDED DOCUMENT &amp; LIVE BIOMETRIC CHECKS" android:textSize="11sp" android:textStyle="bold"
                    android:textColor="@color/text_secondary" android:layout_marginBottom="6dp" android:tag="brand:text=on_surface" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Follow each check below. Selfies auto-capture when your face is framed; live video records directly from camera."
                    android:textSize="12sp" android:textColor="@color/text_secondary"
                    android:layout_marginBottom="14dp" android:tag="brand:text=on_surface" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ID Document Type" android:textSize="12sp" android:textStyle="bold"
                    android:layout_marginBottom="4dp" />
                <Spinner android:id="@+id/spinner_id_type"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginBottom="12dp" />

                <!-- Govt ID picker -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <Button android:id="@+id/btn_pick_govt_id"
                        android:layout_width="wrap_content" android:layout_height="42dp"
                        android:text="Choose ID Card"
                        android:textSize="13sp"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_marginEnd="12dp" android:tag="brand:button=outline" />
                    <TextView android:id="@+id/tv_govt_id_name"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="No file selected"
                        android:textSize="12sp" android:textColor="@color/text_secondary"
                        android:ellipsize="end" android:maxLines="1" android:tag="brand:text=on_surface" />
                </LinearLayout>

                <!-- Proof of Address picker -->
                <LinearLayout android:id="@+id/ll_poa_row"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <Button android:id="@+id/btn_pick_poa"
                        android:layout_width="wrap_content" android:layout_height="42dp"
                        android:text="Proof of Address"
                        android:textSize="13sp"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_marginEnd="12dp" android:tag="brand:button=outline" />
                    <TextView android:id="@+id/tv_poa_name"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Utility bill / Bank statement"
                        android:textSize="12sp" android:textColor="@color/text_secondary"
                        android:ellipsize="end" android:maxLines="1" android:tag="brand:text=on_surface" />
                </LinearLayout>

                <!-- Selfie picker (auto face-framed) -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="18dp">
                    <Button android:id="@+id/btn_pick_selfie"
                        android:layout_width="wrap_content" android:layout_height="42dp"
                        android:text="Auto Face Selfie"
                        android:textSize="13sp"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_marginEnd="12dp" android:tag="brand:button=outline" />
                    <TextView android:id="@+id/tv_selfie_name"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="No file selected"
                        android:textSize="12sp" android:textColor="@color/text_secondary"
                        android:ellipsize="end" android:maxLines="1" android:tag="brand:text=on_surface" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Live video: look at the camera, say &quot;HI&quot; clearly, then turn your head slowly. Record 1–8 seconds with audio, maximum 3 MB. No gallery uploads."
                    android:textSize="12sp" android:layout_marginBottom="8dp" android:textColor="@color/text_secondary" />
                <Button android:id="@+id/btn_record_video" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Record Live Video (Say HI)" style="@style/Widget.Material3.Button.OutlinedButton" />
                <TextView android:id="@+id/tv_video_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="No recording saved" android:layout_marginBottom="16dp" android:accessibilityLiveRegion="polite" />
                <Button android:id="@+id/btn_upload_documents"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:text="Submit for Verification"
                    android:textSize="15sp" android:textStyle="bold"
                    android:backgroundTint="@color/primary"
                    style="@style/Widget.Material3.Button" android:tag="brand:bg=primary;button=fill" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
