<?xml version="1.0" encoding="utf-8"?>
<!-- Points (VTU Coins) ledger — mirrors web/PointsHistory.php. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:background="@color/primary" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="16dp">
        <ImageButton android:id="@+id/btn_back" android:layout_width="40dp"
            android:layout_height="40dp" android:src="@drawable/ic_home"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF" android:contentDescription="Back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Points History"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <ProgressBar android:id="@+id/progress_bar" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="center"
        android:visibility="gone" android:layout_marginTop="16dp" />

    <!-- Shown when the endpoint fails, so the screen never just renders blank fields. -->
    <TextView android:id="@+id/tv_error" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="13sp"
        android:textColor="#C62828" android:gravity="center"
        android:padding="20dp" android:visibility="gone" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="#FFF8E1"
        android:padding="16dp" android:layout_margin="16dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="COIN BALANCE" android:textSize="11sp" android:textStyle="bold"
                android:textColor="#64748B" />
            <TextView android:id="@+id/tv_points_balance" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0"
                android:textSize="22sp" android:textStyle="bold" android:textColor="#1E293B" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/tv_streak" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="No active streak"
                android:textSize="13sp" android:textStyle="bold" android:textColor="#1E293B" />
            <TextView android:id="@+id/tv_next_bonus" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="11sp"
                android:textColor="#64748B" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/tv_empty" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="No points history found."
        android:textColor="#64748B" android:textSize="14sp" android:gravity="center"
        android:padding="32dp" android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:id="@+id/container_points"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <Button android:id="@+id/btn_load_more" android:layout_width="match_parent"
        android:layout_height="48dp" android:text="Load More" android:textSize="14sp"
        android:layout_margin="12dp" android:visibility="gone"
        style="@style/Widget.Material3.Button.OutlinedButton" />
</LinearLayout>
